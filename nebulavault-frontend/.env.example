# Frontend. Copy to .env.local and fill in.

# Server-side and browser-side origins for the gateway.
GATEWAY_ORIGIN=http://localhost:8080
NEXT_PUBLIC_GATEWAY_ORIGIN=http://localhost:8080

APP_BASE_URL=http://localhost:3000

# Must be byte-identical across the frontend, gateway and auth service, and at
# least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
